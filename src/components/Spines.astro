---
import type { Topic } from '../lib/repo';

interface Props {
	topics: Topic[];
	current?: string;
	/** Heights follow the number of sources, as the books do. */
	sized?: boolean;
	style?: string;
}
const { topics, current, sized, style } = Astro.props;
---

<span class="spines" aria-hidden="true" style={style}>
	{
		topics.map((t) => (
			<span
				class:list={['spine', { on: t.id === current }]}
				style={sized ? `--more: ${Math.max(0, Math.min(2, t.sources - 5))}` : undefined}
			/>
		))
	}
</span>
