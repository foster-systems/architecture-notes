---
import { url } from '../lib/repo';

const { node, level = 3 } = Astro.props;
const Heading = `h${Math.min(level, 6)}`;
---

{
	node.pages.length > 0 && (
		<ul class="index" data-pagefind-ignore>
			{node.pages.map((p) => (
				<li>
					<a href={url(`${p.id}/`)}>
						<span class="index-title">{p.title}</span>
						{p.sources ? <span class="index-count">{p.sources} sources</span> : null}
						{p.description && <span class="index-desc">{p.description}</span>}
					</a>
				</li>
			))}
		</ul>
	)
}
{
	node.sections.map((s) => (
		<section class="subsection" data-pagefind-ignore>
			<Heading class="subsection-title">{s.hasIndex ? <a href={url(`${s.id}/`)}>{s.title}</a> : s.title}</Heading>
			{s.description && <p class="subsection-desc">{s.description}</p>}
			<Astro.self node={s} level={level + 1} />
		</section>
	))
}
