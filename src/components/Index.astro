---
import { url } from '../lib/repo';

const { node, level = 3 } = Astro.props;
const Heading = `h${Math.min(level, 6)}`;
---

{
	node.pages.length > 0 && (
		<ul class="index not-content" data-pagefind-ignore>
			{node.pages.map((p) => (
				<li>
					<a href={url(`${p.id}/`)}>{p.title}</a>
					{p.description && <p>{p.description}</p>}
				</li>
			))}
		</ul>
	)
}
{
	node.sections.map((s) => (
		<section class="index-section" data-pagefind-ignore>
			<Heading>{s.hasIndex ? <a href={url(`${s.id}/`)}>{s.title}</a> : s.title}</Heading>
			{s.description && <p class="index-section-desc">{s.description}</p>}
			<Astro.self node={s} level={level + 1} />
		</section>
	))
}
