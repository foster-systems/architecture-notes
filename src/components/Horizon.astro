---
import type { Horizon } from '../lib/repo';

interface Props {
	value?: Horizon;
	word?: boolean;
	silent?: boolean;
}
const { value, word = false, silent = word } = Astro.props;
---

{
	value && (
		<span class="hz">
			<span class={`spine hz-${value}`} role={silent ? undefined : 'img'} aria-label={silent ? undefined : value} />
			{word && <span class="hz-word">{value}</span>}
		</span>
	)
}
