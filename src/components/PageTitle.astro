---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { ancestors, url } from '../lib/repo';

const trail = ancestors(Astro.locals.starlightRoute.entry.id);
---

{
	trail.length > 0 && (
		<nav class="breadcrumbs" aria-label="Breadcrumbs">
			{trail.map((s) => (s.hasIndex ? <a href={url(`${s.id}/`)}>{s.title}</a> : <span>{s.title}</span>))}
		</nav>
	)
}
<Default />
