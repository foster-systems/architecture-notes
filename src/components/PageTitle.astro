---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { ancestors, url, type Entry } from '../lib/repo';

const { id, data } = Astro.locals.starlightRoute.entry as Entry;
const trail = ancestors(id);
const status = data.horizon || data.reviewed;
---

{
	(trail.length > 0 || status) && (
		<div class="page-eyebrow">
			<nav class="breadcrumbs" aria-label="Breadcrumbs">
				{trail.map((s) => (s.hasIndex ? <a href={url(`${s.id}/`)}>{s.title}</a> : <span>{s.title}</span>))}
			</nav>
			{status && (
				<p class="page-status" data-pagefind-ignore>
					{data.horizon && <span class="horizon">{data.horizon}</span>}
					{data.reviewed && <span>Reviewed {data.reviewed.toISOString().slice(0, 10)}</span>}
				</p>
			)}
		</div>
	)
}
<Default />
