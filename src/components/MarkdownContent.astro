---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { getEntry } from 'astro:content';
import Index from './Index.astro';
import { section, url, type Entry } from '../lib/repo';

const entry = Astro.locals.starlightRoute.entry as Entry;
const { data, filePath } = entry;
const inNotes = filePath?.startsWith('notes/');
const node = filePath?.endsWith('/index.md') ? section(entry.id) : undefined;
const related = (await Promise.all((data.related ?? []).map((id) => getEntry('docs', id)))).filter((e) => e !== undefined);
---

<Default>
	{inNotes && data.description && <p class="lead">{data.description}</p>}
	{data.why && <p class="why">{data.why}</p>}

	{
		data.sources && (
			<>
				<h2 id="sources" data-pagefind-ignore>Sources</h2>
				<ol class="sources not-content">
					{data.sources.map((s) => (
						<li>
							<a class="source-title" href={s.url}><span>{s.title}</span></a>
							<p class="source-meta">
								<span class="source-type" data-pagefind-ignore>{s.type}</span> <span>{s.author}&nbsp;·&nbsp;{s.year}{s.agents && <>&nbsp;·&nbsp;<a href={s.agents}>for agents</a></>}</span>
							</p>
							<p class="source-note">{s.note}</p>
						</li>
					))}
				</ol>
			</>
		)
	}

	<slot />

	{node && <Index node={node} level={2} />}

	{
		related.length > 0 && (
			<nav class="related not-content" aria-labelledby="related">
				<p id="related" class="related-label">Related</p>
				<ul>
					{related.map((r) => (
						<li><a href={url(`${r.id}/`)}>{r.data.title}</a></li>
					))}
				</ul>
			</nav>
		)
	}
</Default>
