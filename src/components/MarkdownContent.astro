---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { getEntry } from 'astro:content';
import Index from './Index.astro';
import { github, lastChanged, section, url, type Entry } from '../lib/repo';

const entry = Astro.locals.starlightRoute.entry as Entry;
const { data, filePath } = entry;
const inNotes = filePath?.startsWith('notes/');
const node = filePath?.endsWith('/index.md') ? section(entry.id) : undefined;
const related = (await Promise.all((data.related ?? []).map((id) => getEntry('docs', id)))).filter((e) => e !== undefined);
const changed = filePath && lastChanged(filePath);
---

<Default>
	{inNotes && data.description && <p class="lead">{data.description}</p>}
	{
		inNotes && !node && (
			<p class="page-meta">
				{data.sources?.length ? <>{data.sources.length} sources · </> : null}
				{changed && <>updated {changed} · </>}
				<a href={`${github}/commits/main/${filePath}`}>history</a> · <a href={url(`${entry.id}.md`)}>markdown</a>
			</p>
		)
	}
	{
		data.why && (
			<aside class="why">
				<strong>Why it matters</strong> {data.why}
			</aside>
		)
	}

	{
		data.sources && (
			<>
				<h2 id="sources">Sources</h2>
				<ol class="sources not-content">
					{data.sources.map((s) => (
						<li>
							<a href={s.url}>
								{s.title}
								<span aria-hidden="true"> ↗</span>
							</a>
							<span class="source-meta">
								<span class="source-type">{s.type}</span> {s.author} · {s.year}
								{s.agents && <> · <a href={s.agents}>for agents</a></>}
							</span>
							<p>{s.note}</p>
						</li>
					))}
				</ol>
			</>
		)
	}

	<slot />

	{
		node && (
			<div class="not-content">
				<Index node={node} level={2} />
			</div>
		)
	}

	{
		related.length > 0 && (
			<p class="related">
				Related:{' '}
				{related.map((r, i) => (
					<>
						{i > 0 && ' · '}
						<a href={url(`${r.id}/`)}>{r.data.title}</a>
					</>
				))}
			</p>
		)
	}
</Default>
