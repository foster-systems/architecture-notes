---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { getEntry } from 'astro:content';
import TopicList from './TopicList.astro';
import { github, lastChanged, url, isSection, isTopic, sectionOf, slug, topicsIn, type Topic } from '../lib/repo';

const entry = Astro.locals.starlightRoute.entry as Topic;
const { data, filePath } = entry;
const topic = isTopic(entry);
const section = isSection(entry);
const topics = section ? await topicsIn(sectionOf(entry)) : [];
const related = (await Promise.all((data.related ?? []).map((id) => getEntry('docs', id)))).filter((e) => e !== undefined);
const changed = filePath && lastChanged(filePath);
---

<Default>
	{data.description && (topic || section) && <p class="lead">{data.description}</p>}
	{
		topic && filePath && (
			<p class="page-meta">
				{data.sources?.length ? <>{data.sources.length} sources · </> : null}
				{changed && <>updated {changed} · </>}
				<a href={`${github}/commits/main/${filePath}`}>history</a> · <a href={url(`${slug(entry)}.md`)}>markdown</a>
			</p>
		)
	}
	{
		data.why && (
			<aside class="why">
				<strong>Why it matters</strong> {data.why}
			</aside>
		)
	}

	{
		data.sources && (
			<>
				<h2 id="sources">Sources</h2>
				<ol class="sources not-content">
					{data.sources.map((s) => (
						<li>
							<a href={s.url}>
								{s.title}
								<span aria-hidden="true"> ↗</span>
							</a>
							<span class="source-meta">
								<span class="source-type">{s.type}</span> {s.author} · {s.year}
								{s.agents && <> · <a href={s.agents}>for agents</a></>}
							</span>
							<p>{s.note}</p>
						</li>
					))}
				</ol>
			</>
		)
	}

	<slot />

	{topics.length > 0 && <TopicList topics={topics} />}

	{
		related.length > 0 && (
			<p class="related">
				Related:{' '}
				{related.map((r, i) => (
					<>
						{i > 0 && ' · '}
						<a href={url(`${slug(r)}/`)}>{r.data.title}</a>
					</>
				))}
			</p>
		)
	}
</Default>
