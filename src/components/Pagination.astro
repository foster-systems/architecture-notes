---
import { Icon } from '@astrojs/starlight/components';
import { ancestors, section } from '../lib/repo';
import { startHere } from '../../site.config.mjs';

const { entry, pagination } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sectionOf = (id: string) => (section(id) ?? ancestors(id).at(-1))?.title || startHere;
const here = sectionOf(entry.id);
const links = (['prev', 'next'] as const).flatMap((rel) => {
	const to = pagination[rel];
	if (!to) return [];
	const there = sectionOf(to.href.slice(base.length).replace(/^\/|\/$/g, ''));
	return [{ rel, to, there: there !== here ? there : undefined }];
});
---

{
	links.length > 0 && (
		<nav class="pagination-links print:hidden" aria-label="Previous and next">
			{links.map(({ rel, to, there }) => (
				<a href={to.href} rel={rel}>
					<Icon name={rel === 'prev' ? 'left-arrow' : 'right-arrow'} size="1.125rem" />
					<span>
						<span class="pagination-label">
							{Astro.locals.t(rel === 'prev' ? 'page.previousLink' : 'page.nextLink')}
							{there && <> · {there}</>}
						</span>
						<span class="link-title">{to.label}</span>
					</span>
				</a>
			))}
		</nav>
	)
}
