---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PostList from '../../components/PostList.astro';
import { posts, url } from '../../lib/repo';
---

<StarlightPage frontmatter={{ title: 'Posts', description: 'What changed in the notes, and why. Newest first.' }}>
	<p class="lead">What changed in the notes, and why. Newest first. <a href={url('posts/rss.xml')}>RSS</a></p>
	<PostList posts={await posts()} />
</StarlightPage>
