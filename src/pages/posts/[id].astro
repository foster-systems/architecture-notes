---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { addedIn, github, postDate, slug, url, type Post } from '../../lib/repo';

export async function getStaticPaths() {
	return (await getCollection('posts')).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const topics = (await Promise.all(post.data.topics.map((id) => getEntry('docs', id)))).filter((e) => e !== undefined);
const commit = post.filePath && addedIn(post.filePath);
---

<StarlightPage frontmatter={{ title: post.data.title, description: post.data.description }}>
	<p class="post-meta">
		{postDate(post)}
		{commit && <> · <a href={`${github}/commit/${commit}`}>See the change</a></>}
	</p>
	<Content />
	{
		topics.length > 0 && (
			<p class="related">
				Topics:{' '}
				{topics.map((t, i) => (
					<>
						{i > 0 && ', '}
						<a href={url(`${slug(t)}/`)}>{t.data.title}</a>
					</>
				))}
			</p>
		)
	}
</StarlightPage>
