---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TopicList from '../components/TopicList.astro';
import { github, sections, slug, topicsIn, url } from '../lib/repo';

const groups = await Promise.all((await sections()).map(async (s) => ({ s, topics: await topicsIn(slug(s)) })));
---

<StarlightPage
	frontmatter={{
		title: 'Software architecture in the era of agents',
		description: 'Solution architecture with AI agents: curated sources, each with a note, and a take on each topic. By Przemek Łuniewski.',
		template: 'splash',
	}}
>
	<p class="lead">The sources I trust on solution architecture with AI agents, each with my note, and my take on each topic.</p>
	<p class="byline">By <a href="https://foster.systems">Przemek Łuniewski</a></p>
	<div class="actions not-content">
		<a class="button" href="#topics">Browse topics</a>
		<a class="button secondary" href={url('about/')}>About these notes</a>
	</div>

	<h2 id="topics">Topics</h2>
	{
		groups.map(({ s, topics }) => (
			<section class="group">
				<div>
					<h3>
						<a href={url(`${slug(s)}/`)}>{s.data.title}</a>
					</h3>
					<p>{s.data.description}</p>
				</div>
				<TopicList topics={topics} />
			</section>
		))
	}

	<p class="agents">
		For agents: <a href={url('llms.txt')}>llms.txt</a> · Markdown at every topic URL + <code>.md</code> · <a href={github}>repo</a>
	</p>
</StarlightPage>
