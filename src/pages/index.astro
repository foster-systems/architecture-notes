---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Index from '../components/Index.astro';
import { notes, url } from '../lib/repo';
---

<StarlightPage
	frontmatter={{
		title: 'Software architecture in the era of agents',
		description: 'Solution architecture with AI agents: curated sources, each with a note. By Przemek Łuniewski.',
		pagefind: false,
	}}
>
	<p class="lead">The sources I trust on solution architecture with AI agents, each with my note. <a href={url('about/')}>About these notes</a>.</p>
	<Index node={{ ...notes, pages: [] }} level={2} />
</StarlightPage>
