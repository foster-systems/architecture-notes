---
import Base from '../layouts/Base.astro';
import Books from '../components/Books.astro';
import Horizon from '../components/Horizon.astro';
import Rows from '../components/Rows.astro';
import { horizons, notes, sectionUrl, stats, tone, topicsOf, two, url, typeset } from '../lib/repo';

let seen = 0;
const numbered = notes.sections.map((s, i) => {
	const topics = topicsOf(s);
	const from = seen;
	seen += topics.length;
	return { ...s, num: two(i + 1), topics, from };
});
/** Whole sections in `n` runs of about equal length; a section head counts as `head` topics. */
const runs = (n: number, head = 0) => {
	const size = (s: (typeof numbered)[number]) => s.topics.length + head;
	const total = numbered.reduce((sum, s) => sum + size(s), 0);
	const out = Array.from({ length: n }, () => [] as typeof numbered);
	let sum = 0;
	for (const s of numbered) {
		out[Math.min(n - 1, Math.floor((sum + size(s) / 2) / (total / n)))].push(s);
		sum += size(s);
	}
	return out;
};
const shelves = runs(2);
const columns = runs(3, 3);
---

<Base
	title="Shelf: a reading list on building and running software technology"
	description="The best free sources on building and running software technology, sorted by topic. Each comes with a short note on what it is, so you know before you click."
	index={false}
	home
>
	<section class="hero">
		<div class="container">
			<p class="eyebrow">{stats.sections} sections · {stats.topics} topics · {stats.sources} sources</p>
			<div class="hero-head">
				<h1>Shelf</h1>
				<p class="hero-line">Building and running software technology. <a href={url('about/')}>More…</a></p>
			</div>
			<div class="bookcase">
				<p class="key">
					<span class="legend">
						{horizons.map((h) => (
							<button type="button" aria-pressed="false" data-legend={h}>
								<Horizon value={h} word />
								<span class="count">{stats.horizon(h)}</span>
							</button>
						))}
					</span>
					<span>Reviewed {stats.reviewed}</span>
				</p>
				<div class="shelves">
					{shelves.map((shelf) => (
						<ol class="shelf">
							{shelf.map((s) => (
								<li class="group" style={tone(s.id)}>
									<Books topics={s.topics} from={s.from} label={s.title} />
									<a class="group-label" href={`#${s.id}`}>
										<span class="num">{s.num}</span>
										{s.title}
									</a>
								</li>
							))}
						</ol>
					))}
				</div>
				<p class="ticks" aria-hidden="true">
					{numbered.map((s) => (
						<span style={`flex-grow: ${s.topics.length}; ${tone(s.id)}`} />
					))}
				</p>
			</div>
		</div>
	</section>

	<section class="catalogue">
		<div class="container">
			<p class="key catalogue-key">
				<span class="legend">
					{horizons.map((h) => (
						<button type="button" aria-pressed="false" data-legend={h}>
							<Horizon value={h} word />
						</button>
					))}
				</span>
			</p>
			<div class="catalogue-cols">
				{columns.map((column) => (
					<div>
						{column.map((s) => (
							<section class="block" id={s.id} style={tone(s.id)}>
								<div class="block-head">
									<h2>
										<span class="num">{s.num}</span>
										<a href={sectionUrl(s)}>{s.title}</a>
									</h2>
									<span class="count">sources</span>
								</div>
								{s.description && <p class="block-desc">{typeset(s.description)}</p>}
								<Rows topics={s.topics} />
							</section>
						))}
					</div>
				))}
			</div>
		</div>
	</section>
</Base>

<script>
	const bookcase = document.querySelector<HTMLElement>('.bookcase')!;

	// One horizon at a time: press a legend item to dim the rest, on the shelves and in the catalogue.
	const legend = [...document.querySelectorAll<HTMLButtonElement>('[data-legend]')];
	const only = (horizon?: string) => {
		if (horizon) document.body.dataset.only = horizon;
		else delete document.body.dataset.only;
		legend.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.legend === horizon)));
	};
	legend.forEach((b) => b.addEventListener('click', () => only(b.getAttribute('aria-pressed') === 'true' ? undefined : b.dataset.legend)));
	addEventListener('keydown', (e) => e.key === 'Escape' && !document.querySelector('dialog[open]') && only());

	// The catalogue's legend shows once the first one has left the screen.
	new IntersectionObserver((entries) => document.body.toggleAttribute('data-key-out', !entries.at(-1)!.isIntersecting), {
		rootMargin: `-${document.querySelector<HTMLElement>('.bar')!.offsetHeight}px 0px 0px`,
	}).observe(bookcase.querySelector('.legend')!);

	// Phone: the shelf scrolls sideways; the ticks show which sections are in view.
	const shelves = bookcase.querySelector<HTMLElement>('.shelves')!;
	const ticks = bookcase.querySelectorAll('.ticks span');
	const seen = new IntersectionObserver(
		(entries) => entries.forEach((e) => ticks[groups.indexOf(e.target)].toggleAttribute('data-on', e.isIntersecting)),
		{ root: shelves, threshold: 0.5 },
	);
	const groups: Element[] = [...shelves.querySelectorAll('.group')];
	groups.forEach((g) => seen.observe(g));
	shelves.addEventListener('scroll', () => shelves.toggleAttribute('data-scrolled', shelves.scrollLeft > 8), { passive: true });

	// Each section is one tab stop; arrow keys walk its books.
	bookcase.querySelectorAll('[role=toolbar]').forEach((books) => {
		const links = [...books.querySelectorAll('a')];
		links.slice(1).forEach((a) => (a.tabIndex = -1));
		books.addEventListener('keydown', (e) => {
			const step = { ArrowRight: 1, ArrowLeft: -1 }[(e as KeyboardEvent).key];
			const next = step && links[links.indexOf(document.activeElement as HTMLAnchorElement) + step];
			if (!next) return;
			e.preventDefault();
			links.forEach((a) => (a.tabIndex = a === next ? 0 : -1));
			next.focus();
		});
	});
</script>
