---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles.css';
import Mark from '../components/Mark.astro';
import Search from '../components/Search.astro';
import Sections from '../components/Sections.astro';
import { parent } from '../../site.config.mjs';
import { github, lastChanged, url, type Entry } from '../lib/repo';

interface Props {
	title: string;
	description?: string;
	entry?: Entry;
	index?: boolean;
	home?: boolean;
}
const { title, description, entry, index = true, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const about = url('about/');
const file = entry?.filePath;
const page = file && !file.endsWith('/index.md');
const changed = page && !entry.data.reviewed && lastChanged(file);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{home ? title : `${title} | Shelf`}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
		<link rel="sitemap" href={url('sitemap-index.xml')} />
		<meta property="og:title" content={title} />
		<meta property="og:type" content={home ? 'website' : 'article'} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Shelf" />
		{description && <meta property="og:description" content={description} />}
		<meta name="twitter:card" content="summary" />
		<script is:inline>
			try {
				document.documentElement.dataset.theme =
					localStorage.getItem('theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			} catch {}
		</script>
	</head>
	<body class:list={{ home }}>
		<a class="skip" href="#main">Skip to content</a>
		<header class="bar">
			<div class="container bar-row">
				<p class="lockup">
					<a class="lockup-home" href={url('')}><Mark />Shelf</a>
					<span class="lockup-by">by <a href={parent}>foster.systems</a></span>
				</p>
				<nav class="bar-nav" aria-label="Site">
					<button class="search-open" type="button" aria-label="Search" data-search-open>
						<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
						<span>Search</span>
						<kbd>Ctrl K</kbd>
					</button>
					<a class="bar-link wide" href={about} aria-current={Astro.url.pathname === about ? 'page' : undefined}>About</a>
					<a class="bar-icon wide" href={github} aria-label="GitHub">
						<svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
					</a>
					<button class="bar-icon theme wide" type="button" aria-label="Switch between light and dark" data-theme-toggle>
						<svg viewBox="0 0 24 24" aria-hidden="true" class="moon"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
						<svg viewBox="0 0 24 24" aria-hidden="true" class="sun"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" /></svg>
					</button>
					<button class="bar-icon menu-open" type="button" aria-label="Menu" data-menu-open>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
					</button>
				</nav>
			</div>
		</header>

		<main id="main" data-pagefind-body={index ? '' : undefined}>
			<slot />
		</main>

		<footer class="container">
			<div class="foot">
			<p>By <a href={parent}>Przemek Łuniewski</a></p>
			<p class="dots">
				{file && <span><a href={`${github}/edit/main/${file}`}>Edit</a></span>}
				{page && <span><a href={`${github}/commits/main/${file}`}>History</a></span>}
				{page && <span><a href={url(`${entry.id}.md`)}>Markdown</a></span>}
				{changed && <span>Updated {changed}</span>}
				<span><a href={github}>GitHub</a></span>
				<span><a href={url('llms.txt')}>llms.txt</a></span>
			</p>
			</div>
		</footer>

		<dialog class="menu" aria-label="Menu">
			<div class="menu-head">
				<a class="lockup-home" href={url('')}><Mark />Shelf</a>
				<button class="bar-icon" type="button" aria-label="Close menu" data-close>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
				</button>
			</div>
			<Sections current={entry?.id.split('/')[0]} />
			<div class="menu-foot">
				<a href={about}>About</a>
				<a href={github}>GitHub</a>
				<button class="bar-icon theme" type="button" aria-label="Switch between light and dark" data-theme-toggle>
					<svg viewBox="0 0 24 24" aria-hidden="true" class="moon"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
					<svg viewBox="0 0 24 24" aria-hidden="true" class="sun"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" /></svg>
				</button>
			</div>
		</dialog>

		<Search />

		<script>
			const root = document.documentElement;
			document.querySelectorAll('[data-theme-toggle]').forEach((button) =>
				button.addEventListener('click', () => {
					const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
					root.dataset.theme = theme;
					try {
						localStorage.setItem('theme', theme);
					} catch {}
				}),
			);

			const menu = document.querySelector<HTMLDialogElement>('dialog.menu')!;
			document.querySelector('[data-menu-open]')!.addEventListener('click', () => menu.showModal());
			// A dialog closes on its close button, on a link inside it, and on a press that started on the backdrop.
			document.querySelectorAll('dialog').forEach((dialog) => {
				let outside = false;
				dialog.addEventListener('pointerdown', (e) => {
					const box = dialog.getBoundingClientRect();
					outside = e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom;
				});
				dialog.addEventListener('click', (e) => {
					if (outside || (e.target as Element).closest('a, [data-close]')) dialog.close();
					outside = false;
				});
			});
		</script>
	</body>
</html>
